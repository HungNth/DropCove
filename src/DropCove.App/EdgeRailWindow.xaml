<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DropCove.EdgeRailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DropCove"
    Title="DropCove Edge Rail">
    <!-- The window surface is transparent so XAML antialiases the rounded corners; RailRoot restores the opaque base the window used to clear to. -->
    <Border x:Name="RailRoot" Background="{ThemeResource RailBaseBrush}" CornerRadius="8,0,0,8">
    <Grid
        x:Name="RailSurface"
        AllowDrop="True"
        Padding="4"
        AutomationProperties.Name="Edge Rail"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        CornerRadius="8,0,0,8"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,1"
        DragEnter="OnRailDragEnter"
        DragLeave="OnRailDragLeave"
        DragOver="OnRailDragOver"
        Drop="OnRailDrop"
        PointerMoved="OnRailPointerMoved"
        PointerExited="OnRailPointerExited">
        <Grid.Resources>
            <Style x:Key="RailActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                <Setter Property="AllowFocusOnInteraction" Value="False" />
            </Style>
            <Style x:Key="RailActionToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource TitleBarToggleButtonStyle}">
                <Setter Property="AllowFocusOnInteraction" Value="False" />
            </Style>
            <Style x:Key="RailManagementPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="MaxHeight" Value="480" />
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="IsDefaultShadowEnabled" Value="False" />
            </Style>
            <DataTemplate x:Key="RailManagementItemTemplate" x:DataType="local:ShelfItemViewModel">
                <Border Tag="{x:Bind}" DataContext="{x:Bind}" Margin="0,0,0,4" Padding="4" CornerRadius="4"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        AutomationProperties.Name="{x:Bind DragAutomationName, Mode=OneWay}"
                        CanDrag="True" DragStarting="OnRailItemDragStarting" DropCompleted="OnRailItemDropCompleted">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Width="24" Height="24" VerticalAlignment="Center" IsTabStop="False" IsHitTestVisible="False"
                                        Content="{x:Bind}" ContentTemplate="{StaticResource ShelfItemVisualTemplate}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Path, Mode=OneWay}"
                                       Text="{x:Bind DisplayPath, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       IsTextTrimmedChanged="OnManagementItemPathTrimmed"
                                       ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}" />
                            <TextBlock FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind DetailsLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Width="24" Height="24" Style="{StaticResource RailActionToggleButtonStyle}"
                                          Tag="{x:Bind}" Click="OnManagementItemPinClicked" IsEnabled="{x:Bind ActionsEnabled, Mode=OneWay}"
                                          IsChecked="{x:Bind IsPinned, Mode=OneWay}" AutomationProperties.Name="{x:Bind PinAutomationName, Mode=OneWay}"
                                          ToolTipService.ToolTip="Pin / Unpin">
                                <FontIcon FontSize="11" Glyph="&#xE718;" />
                            </ToggleButton>
                            <Button Width="24" Height="24" Style="{StaticResource RailActionButtonStyle}"
                                    Tag="{x:Bind}" Click="OnManagementItemRemoveClicked" IsEnabled="{x:Bind ActionsEnabled, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                    ToolTipService.ToolTip="Remove Item" Content="×" FontSize="14" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            x:Name="OpenShelfButton"
            Width="28"
            Height="28"
            MinWidth="0"
            Padding="0"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="Opens the full Drop Shelf and activates DropCove."
            AutomationProperties.Name="Open Shelf"
            Click="OnOpenShelfClicked"
            ToolTipService.ToolTip="Open Shelf">
            <FontIcon FontSize="11" Glyph="&#xE8A7;" />
        </Button>

        <ListView x:Name="BatchList" Grid.Row="1" Margin="0,4,0,4" Padding="0"
                  Visibility="Collapsed" SelectionMode="None" ContainerContentChanging="OnBatchContainerContentChanging"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsTabStop" Value="False" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" CacheLength="0" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:RailBatchSummary">
                        <Border
                            DataContext="{x:Bind}"
                            Padding="3"
                            Margin="{x:Bind RowMargin, Mode=OneWay}"
                            Height="64"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind Presentation.DragBatchAutomationName, Mode=OneWay}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CanDrag="True"
                            CornerRadius="5"
                            DragStarting="OnRailBatchDragStarting"
                            DropCompleted="OnRailBatchDropCompleted"
                            ToolTipService.ToolTip="Drag all items in batch">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Width="42" Height="42" VerticalAlignment="Center"
                                                IsTabStop="False" IsHitTestVisible="False"
                                                Content="{x:Bind Presentation}" ContentTemplate="{StaticResource ShelfBatchPreviewTemplate}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="{x:Bind Presentation.Title, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind Presentation.Title, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind Presentation.Subtitle, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Presentation.Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                    <ToggleButton Width="24" Height="24" Style="{StaticResource RailActionToggleButtonStyle}"
                                                  Tag="{x:Bind}" Click="OnRailPinClicked" IsEnabled="{x:Bind ActionsEnabled, Mode=OneWay}"
                                                  IsChecked="{x:Bind Presentation.IsPinned, Mode=OneWay}"
                                                  Visibility="{x:Bind Presentation.SingleItemVisibility, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind Presentation.SingleItemPinAutomationName, Mode=OneWay}"
                                                  ToolTipService.ToolTip="Pin / Unpin">
                                        <FontIcon FontSize="11" Glyph="&#xE718;" />
                                    </ToggleButton>
                                    <ToggleButton Width="24" Height="24" Style="{StaticResource RailActionToggleButtonStyle}"
                                                  Tag="{x:Bind}" Click="OnRailPinClicked" IsEnabled="{x:Bind ActionsEnabled, Mode=OneWay}"
                                                  IsThreeState="True" IsChecked="{x:Bind Presentation.BulkPinState, Mode=OneWay}"
                                                  Visibility="{x:Bind Presentation.MultiItemVisibility, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind Presentation.BulkPinAutomationName, Mode=OneWay}"
                                                  ToolTipService.ToolTip="{x:Bind Presentation.BulkPinAutomationName, Mode=OneWay}"
                                                  Content="{x:Bind Presentation}" ContentTemplate="{StaticResource BulkPinIconTemplate}" />
                                <Button
                                    AutomationProperties.Name="{x:Bind Presentation.ManageItemsAutomationName, Mode=OneWay}"
                                    Style="{StaticResource RailActionButtonStyle}" Width="24" Height="24"
                                    IsEnabled="{x:Bind ActionsEnabled, Mode=OneWay}"
                                    Tag="{x:Bind}" Click="OnManageItemsClicked" PreviewKeyDown="OnManageItemsKeyDown"
                                    Visibility="{x:Bind ManageItemsVisibility, Mode=OneWay}"
                                    ToolTipService.ToolTip="Manage items">
                                    <FontIcon FontSize="9" Glyph="&#xE70D;" />
                                </Button>
                                    <Button Width="24" Height="24" Style="{StaticResource RailActionButtonStyle}"
                                            Tag="{x:Bind}" Click="OnRailRemoveClicked" IsEnabled="{x:Bind ActionsEnabled, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind RemoveAutomationName, Mode=OneWay}" Content="×" FontSize="14" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button x:Name="ClearTemporaryButton" Grid.Row="2" Width="28" Height="28" Visibility="Collapsed"
                MinWidth="0" Padding="0"
                HorizontalAlignment="Left" AutomationProperties.Name="Clear Temporary Items"
                ToolTipService.ToolTip="Clear Temporary Items" Click="OnClearTemporaryClicked">
            <FontIcon FontSize="11" Glyph="&#xE74D;" />
        </Button>
    </Grid>
    </Border>
</Window>
