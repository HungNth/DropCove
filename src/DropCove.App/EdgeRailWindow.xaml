<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DropCove.EdgeRailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DropCove"
    Title="DropCove Edge Rail">
    <Grid
        x:Name="RailRoot"
        AllowDrop="True"
        Padding="4"
        AutomationProperties.Name="Edge Rail"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        DragEnter="OnRailDragEnter"
        DragLeave="OnRailDragLeave"
        DragOver="OnRailDragOver"
        Drop="OnRailDrop"
        PointerMoved="OnRailPointerMoved"
        PointerExited="OnRailPointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button
            x:Name="OpenShelfButton"
            Width="56"
            Height="32"
            HorizontalAlignment="Center"
            AutomationProperties.HelpText="Opens the full Drop Shelf and activates DropCove."
            AutomationProperties.Name="Open Shelf"
            Click="OnOpenShelfClicked"
            ToolTipService.ToolTip="Open Shelf">
            <FontIcon FontSize="14" Glyph="&#xE8A7;" />
        </Button>

        <ScrollViewer
            x:Name="BatchScroller"
            Grid.Row="1"
            Margin="0,4,0,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden">
            <ItemsRepeater x:Name="BatchList" HorizontalCacheLength="0" VerticalCacheLength="0">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:RailBatchSummary">
                        <Border
                            Padding="3"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CanDrag="True"
                            CornerRadius="5"
                            DragStarting="OnRailBatchDragStarting"
                            DropCompleted="OnRailBatchDropCompleted"
                            ToolTipService.ToolTip="Drag all items in batch">
                            <StackPanel HorizontalAlignment="Stretch" Spacing="2">
                                <Grid Width="48" Height="28" HorizontalAlignment="Center">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="17"
                                        Glyph="{x:Bind Glyph, Mode=OneTime}" />
                                    <TextBlock
                                        Margin="0,0,2,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        FontSize="10"
                                        Text="{x:Bind PinnedGlyph, Mode=OneTime}" />
                                </Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Title, Mode=OneTime}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    MaxWidth="260"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="8"
                                    Text="{x:Bind Subtitle, Mode=OneTime}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <Button
                                    AutomationProperties.Name="{x:Bind FlyoutAutomationName, Mode=OneTime}"
                                    ClickMode="Press"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Padding="6,0"
                                    PointerPressed="OnBatchFlyoutButtonPointerPressed"
                                    Visibility="{x:Bind FlyoutVisibility, Mode=OneTime}"
                                    ToolTipService.ToolTip="Show batch items">
                                    <TextBlock FontSize="9" Text="Items" />
                                    <Button.Flyout>
                                        <Flyout
                                            Closed="OnBatchFlyoutClosed"
                                            Opened="OnBatchFlyoutOpened">
                                            <ScrollViewer
                                                Width="260"
                                                MaxHeight="480"
                                                HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                                                <ItemsRepeater ItemsSource="{Binding Items}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="local:RailItemSummary">
                                                            <Border
                                                                Padding="6"
                                                                AutomationProperties.Name="{x:Bind DragAutomationName, Mode=OneTime}"
                                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                CanDrag="True"
                                                                CornerRadius="4"
                                                                DragStarting="OnRailItemDragStarting"
                                                                DropCompleted="OnRailItemDropCompleted">
                                                                <Grid ColumnSpacing="6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="24" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                                        <FontIcon FontSize="13" Glyph="{x:Bind Glyph, Mode=OneTime}" />
                                                                    </Grid>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock
                                                                            FontSize="10"
                                                                            FontWeight="SemiBold"
                                                                            Text="{x:Bind Name, Mode=OneTime}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="NoWrap" />
                                                                        <TextBlock
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            FontSize="9"
                                                                            Text="{x:Bind Type, Mode=OneTime}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="NoWrap" />
                                                                    </StackPanel>
                                                                    <TextBlock
                                                                        Grid.Column="2"
                                                                        FontSize="11"
                                                                        Text="{x:Bind PinnedGlyph, Mode=OneTime}"
                                                                        VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Window>
