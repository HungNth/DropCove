<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DropCove.EdgeRailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DropCove"
    Title="DropCove Edge Rail">
    <!-- The window surface is transparent so XAML antialiases the rounded corners; RailRoot restores the opaque base the window used to clear to. -->
    <Border x:Name="RailRoot" Background="{ThemeResource RailBaseBrush}" CornerRadius="8,0,0,8">
    <Grid
        x:Name="RailSurface"
        AllowDrop="True"
        Padding="4"
        AutomationProperties.Name="Edge Rail"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        CornerRadius="8,0,0,8"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,1"
        DragEnter="OnRailDragEnter"
        DragLeave="OnRailDragLeave"
        DragOver="OnRailDragOver"
        Drop="OnRailDrop"
        PointerMoved="OnRailPointerMoved"
        PointerExited="OnRailPointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            x:Name="OpenShelfButton"
            Width="28"
            Height="28"
            MinWidth="0"
            Padding="0"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="Opens the full Drop Shelf and activates DropCove."
            AutomationProperties.Name="Open Shelf"
            Click="OnOpenShelfClicked"
            ToolTipService.ToolTip="Open Shelf">
            <FontIcon FontSize="11" Glyph="&#xE8A7;" />
        </Button>

        <ListView x:Name="BatchList" Grid.Row="1" Margin="0,4,0,4" Padding="0"
                  Visibility="Collapsed" SelectionMode="None"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsTabStop" Value="False" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" CacheLength="0" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:RailBatchSummary">
                        <Border
                            DataContext="{x:Bind}"
                            Padding="3"
                            Margin="{x:Bind RowMargin, Mode=OneTime}"
                            Height="64"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CanDrag="True"
                            CornerRadius="5"
                            DragStarting="OnRailBatchDragStarting"
                            DropCompleted="OnRailBatchDropCompleted"
                            ToolTipService.ToolTip="Drag all items in batch">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontSize="17" Glyph="{x:Bind Glyph, Mode=OneTime}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="{x:Bind Title, Mode=OneTime}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind Subtitle, Mode=OneTime}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontSize="10" HorizontalAlignment="Right" Text="{x:Bind PinnedGlyph, Mode=OneTime}" />
                                <Button
                                    AutomationProperties.Name="{x:Bind FlyoutAutomationName, Mode=OneTime}"
                                    ClickMode="Press"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Padding="6,0"
                                    PointerPressed="OnBatchFlyoutButtonPointerPressed"
                                    Visibility="{x:Bind FlyoutVisibility, Mode=OneTime}"
                                    ToolTipService.ToolTip="Show batch items">
                                    <TextBlock FontSize="9" Text="Items" />
                                    <Button.Flyout>
                                        <Flyout
                                            Closed="OnBatchFlyoutClosed"
                                            Opened="OnBatchFlyoutOpened">
                                            <ScrollViewer
                                                Width="260"
                                                MaxHeight="480"
                                                HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                                                <ItemsRepeater ItemsSource="{x:Bind Items}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="local:RailItemSummary">
                                                            <Border
                                                                DataContext="{x:Bind}"
                                                                Padding="6"
                                                                AutomationProperties.Name="{x:Bind DragAutomationName, Mode=OneTime}"
                                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                CanDrag="True"
                                                                CornerRadius="4"
                                                                DragStarting="OnRailItemDragStarting"
                                                                DropCompleted="OnRailItemDropCompleted">
                                                                <Grid ColumnSpacing="6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="24" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                                        <FontIcon FontSize="13" Glyph="{x:Bind Glyph, Mode=OneTime}" />
                                                                    </Grid>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock
                                                                            FontSize="10"
                                                                            FontWeight="SemiBold"
                                                                            Text="{x:Bind Name, Mode=OneTime}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="NoWrap" />
                                                                        <TextBlock
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            FontSize="9"
                                                                            Text="{x:Bind Type, Mode=OneTime}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="NoWrap" />
                                                                    </StackPanel>
                                                                    <TextBlock
                                                                        Grid.Column="2"
                                                                        FontSize="11"
                                                                        Text="{x:Bind PinnedGlyph, Mode=OneTime}"
                                                                        VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button x:Name="ClearTemporaryButton" Grid.Row="2" Width="28" Height="28" Visibility="Collapsed"
                MinWidth="0" Padding="0"
                HorizontalAlignment="Left" AutomationProperties.Name="Clear Temporary Items"
                ToolTipService.ToolTip="Clear Temporary Items" Click="OnClearTemporaryClicked">
            <FontIcon FontSize="11" Glyph="&#xE74D;" />
        </Button>
    </Grid>
    </Border>
</Window>
