<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DropCove.EdgeRailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DropCove Edge Rail">
    <Grid
        Padding="4"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button
            x:Name="OpenShelfButton"
            Width="56"
            Height="32"
            HorizontalAlignment="Center"
            AutomationProperties.Name="Open Shelf"
            Click="OnOpenShelfClicked"
            ToolTipService.ToolTip="Open Shelf">
            <FontIcon FontSize="14" Glyph="&#xE8A7;" />
        </Button>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,4,0,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="BatchList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="3"
                            AutomationProperties.Name="{Binding AutomationName}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <Grid Width="48" Height="28">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="17"
                                        Glyph="{Binding Glyph}" />
                                    <TextBlock
                                        Margin="0,0,2,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        FontSize="10"
                                        Text="{Binding PinnedGlyph}" />
                                </Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    MaxWidth="52"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="8"
                                    Text="{Binding Subtitle}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Window>
