<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DropCove.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="True"
    KeyDown="OnPageKeyDown"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="DragRegion"
                Grid.Column="0"
                Background="Transparent"
                PointerPressed="OnDragRegionPointerPressed" />

            <TextBlock
                x:Name="OverflowLabel"
                Grid.Column="1"
                Margin="4,0"
                VerticalAlignment="Center"
                FontSize="11"
                Text="+1 batch"
                Visibility="Collapsed" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Stretch">
                <Button
                    x:Name="ClearTemporaryButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Width="32"
                    Height="32"
                    AutomationProperties.Name="Clear Temporary Items"
                    Click="OnClearTemporaryClicked"
                    ToolTipService.ToolTip="Clear Temporary Items">
                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                </Button>

                <Button
                    x:Name="SettingsButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Width="32"
                    Height="32"
                    AutomationProperties.Name="Settings"
                    Click="OnSettingsClicked"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="12" Glyph="&#xE713;" />
                </Button>

                <Button
                    x:Name="CloseButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Width="36"
                    Height="32"
                    AutomationProperties.Name="Hide DropCove"
                    Click="OnCloseClicked"
                    ToolTipService.ToolTip="Hide DropCove">
                    <FontIcon FontSize="11" Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            x:Name="ContentSurface"
            Grid.Row="1"
            Padding="8"
            AllowDrop="True"
            DragEnter="OnDragEnter"
            DragLeave="OnDragLeave"
            DragOver="OnDragOver"
            Drop="OnDrop">

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon HorizontalAlignment="Center" FontSize="32" Glyph="&#xE8B7;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Text="Drop files here"
                    TextAlignment="Center" />
            </StackPanel>

            <ScrollViewer
                x:Name="BatchScroller"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <ItemsControl x:Name="BatchList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <Grid
                                        MinHeight="48"
                                        Padding="4"
                                        AutomationProperties.Name="{Binding DragBatchAutomationName}"
                                        CanDrag="True"
                                        ColumnSpacing="6"
                                        DragStarting="OnBatchDragStarting"
                                        DropCompleted="OnBatchDropCompleted"
                                        ToolTipService.ToolTip="Drag all items in batch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="36" Height="36" VerticalAlignment="Center">
                                            <Border
                                                Margin="6,0,0,6"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="{Binding TertiaryVisibility}">
                                                <Grid CornerRadius="5">
                                                    <FontIcon FontSize="14" Glyph="{Binding FallbackGlyph}" />
                                                    <Image Source="{Binding TertiaryIcon}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <Border
                                                Margin="3,3,3,3"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="{Binding SecondaryVisibility}">
                                                <Grid CornerRadius="5">
                                                    <FontIcon FontSize="14" Glyph="{Binding FallbackGlyph}" />
                                                    <Image Source="{Binding SecondaryIcon}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <Border
                                                Margin="0,6,6,0"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Grid CornerRadius="5">
                                                    <FontIcon FontSize="14" Glyph="{Binding FallbackGlyph}" />
                                                    <Image Source="{Binding PrimaryIcon}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                FontSize="9"
                                                Text="{Binding Subtitle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                            <Button
                                                Style="{StaticResource TitleBarButtonStyle}"
                                                Width="22"
                                                Height="22"
                                                AutomationProperties.Name="{Binding RemoveBatchAutomationName}"
                                                Click="OnRemoveBatchClicked"
                                                Content="×"
                                                FontSize="14"
                                                ToolTipService.ToolTip="Remove Batch" />
                                            <Button
                                                Style="{StaticResource TitleBarButtonStyle}"
                                                Width="22"
                                                Height="22"
                                                AutomationProperties.Name="{Binding ToggleExpandAutomationName}"
                                                Click="OnToggleExpandClicked"
                                                ToolTipService.ToolTip="Expand/Collapse">
                                                <FontIcon FontSize="9" Glyph="{Binding ExpandGlyph}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl
                                        ItemsSource="{Binding Items}"
                                        Visibility="{Binding ItemsVisibility}"
                                        Padding="4,0,4,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,4"
                                                    Padding="4"
                                                    AutomationProperties.Name="{Binding DragAutomationName}"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CanDrag="True"
                                                    CornerRadius="4"
                                                    DragStarting="OnItemDragStarting"
                                                    DropCompleted="OnItemDropCompleted">
                                                    <Grid ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                            <FontIcon IsHitTestVisible="False" FontSize="13" Glyph="{Binding FallbackGlyph}" />
                                                            <Image IsHitTestVisible="False" Source="{Binding Icon}" Stretch="UniformToFill" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                                                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                FontSize="9"
                                                                Text="{Binding Type}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ToggleButton
                                                                Style="{StaticResource TitleBarToggleButtonStyle}"
                                                                Width="22"
                                                                Height="22"
                                                                AutomationProperties.Name="{Binding PinAutomationName}"
                                                                Click="OnPinClicked"
                                                                IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                                ToolTipService.ToolTip="Pin / Unpin">
                                                                <FontIcon FontSize="11" Glyph="&#xE718;" />
                                                            </ToggleButton>
                                                            <Button
                                                                Style="{StaticResource TitleBarButtonStyle}"
                                                                Width="22"
                                                                Height="22"
                                                                AutomationProperties.Name="{Binding RemoveAutomationName}"
                                                                Click="OnRemoveItemClicked"
                                                                Content="×"
                                                                FontSize="14"
                                                                ToolTipService.ToolTip="Remove" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border
                x:Name="DragOverlay"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="8"
                Opacity="0.92"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <FontIcon FontSize="28" Foreground="White" Glyph="&#xE8B7;" />
                    <TextBlock Foreground="White" Text="Add to DropCove" />
                </StackPanel>
            </Border>

            <Border
                x:Name="StatusBar"
                VerticalAlignment="Bottom"
                Margin="0,0,0,2"
                Padding="6,4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StatusText"
                        FontSize="10"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Button
                        Grid.Column="1"
                        Width="16"
                        Height="16"
                        MinWidth="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Click="OnDismissStatusClicked"
                        Content="×"
                        FontSize="11" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
