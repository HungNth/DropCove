<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DropCove.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DropCove"
    IsTabStop="True"
    KeyDown="OnPageKeyDown"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="ShelfItemTemplate" x:DataType="local:ShelfItemViewModel">
            <Border
                Margin="0,0,0,4"
                Padding="4"
                AutomationProperties.Name="{x:Bind DragAutomationName, Mode=OneWay}"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CanDrag="True"
                CornerRadius="4"
                DragStarting="OnItemDragStarting"
                DropCompleted="OnItemDropCompleted"
                Tag="{x:Bind}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                        <FontIcon IsHitTestVisible="False" FontSize="13" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                        <Image AutomationProperties.Name="{x:Bind VisualAutomationName, Mode=OneWay}" IsHitTestVisible="False" Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                        <TextBlock
                            FontSize="9"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Path, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="9"
                            Text="{x:Bind DetailsLabel, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton
                            Style="{StaticResource TitleBarToggleButtonStyle}"
                            Width="24"
                            Height="24"
                            AutomationProperties.Name="{x:Bind PinAutomationName, Mode=OneWay}"
                            Click="OnPinClicked"
                            Tag="{x:Bind}"
                            IsChecked="{x:Bind IsPinned, Mode=OneWay}"
                            ToolTipService.ToolTip="Pin / Unpin">
                            <FontIcon FontSize="11" Glyph="&#xE718;" />
                        </ToggleButton>
                        <Button
                            Style="{StaticResource TitleBarButtonStyle}"
                            Width="24"
                            Height="24"
                            AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}"
                            Click="OnRemoveItemClicked"
                            Tag="{x:Bind}"
                            Content="×"
                            FontSize="14"
                            ToolTipService.ToolTip="Remove Item" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BatchTemplate" x:DataType="local:BatchCardViewModel">
            <Border
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <Grid
                        MinHeight="52"
                        Padding="4"
                        AutomationProperties.Name="{x:Bind DragBatchAutomationName, Mode=OneWay}"
                        Background="Transparent"
                        CanDrag="True"
                        ColumnSpacing="6"
                        DragStarting="OnBatchDragStarting"
                        DropCompleted="OnBatchDropCompleted"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Drag all items in batch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="42" Height="42" VerticalAlignment="Center">
                            <Border
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{x:Bind SingleItemVisibility, Mode=OneWay}">
                                <Grid CornerRadius="5">
                                    <FontIcon FontSize="16" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                    <Image Source="{x:Bind PrimaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <Grid Visibility="{x:Bind MultiItemVisibility, Mode=OneWay}">
                                <Border
                                    Margin="5,0,0,5"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid CornerRadius="5">
                                        <FontIcon FontSize="14" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                        <Image Source="{x:Bind TertiaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <Border
                                    Margin="2,2,2,2"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid CornerRadius="5">
                                        <FontIcon FontSize="14" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                        <Image Source="{x:Bind SecondaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <Border
                                    Margin="0,5,5,0"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid CornerRadius="5">
                                        <FontIcon FontSize="14" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                        <Image Source="{x:Bind PrimaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="9"
                                Text="{x:Bind Subtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <ToggleButton
                                Style="{StaticResource TitleBarToggleButtonStyle}"
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="{x:Bind SingleItemPinAutomationName, Mode=OneWay}"
                                Click="OnPinClicked"
                                Tag="{x:Bind}"
                                IsChecked="{x:Bind IsPinned, Mode=OneWay}"
                                ToolTipService.ToolTip="Pin / Unpin"
                                Visibility="{x:Bind SingleItemVisibility, Mode=OneWay}">
                                <FontIcon FontSize="11" Glyph="&#xE718;" />
                            </ToggleButton>
                            <Button
                                x:Name="ManageItemsButton"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="{x:Bind ManageItemsAutomationName, Mode=OneWay}"
                                Click="OnManageItemsClicked"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Manage items"
                                Visibility="{x:Bind MultiItemVisibility, Mode=OneWay}">
                                <FontIcon FontSize="9" Glyph="&#xE70D;" />
                            </Button>
                            <Button
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="{x:Bind RemoveBatchAutomationName, Mode=OneWay}"
                                Click="OnRemoveBatchClicked"
                                Tag="{x:Bind}"
                                Content="×"
                                FontSize="14"
                                ToolTipService.ToolTip="Remove Batch" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="DragRegion"
                Grid.Column="0"
                Background="Transparent" />

            <Button
                x:Name="SettingsButton"
                Grid.Column="1"
                Style="{StaticResource TitleBarButtonStyle}"
                Width="32"
                Height="32"
                AutomationProperties.Name="Settings"
                Click="OnSettingsClicked"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="12" Glyph="&#xE713;" />
            </Button>

            <Button
                x:Name="CloseButton"
                Grid.Column="2"
                Style="{StaticResource TitleBarButtonStyle}"
                Width="36"
                Height="32"
                AutomationProperties.Name="Hide DropCove"
                Click="OnCloseClicked"
                ToolTipService.ToolTip="Hide DropCove">
                <FontIcon FontSize="11" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <Grid
            AutomationProperties.Name="Drop Shelf content and drop target"
            x:Name="ContentSurface"
            Grid.Row="1"
            Padding="8"
            SizeChanged="OnContentSizeChanged"
            AllowDrop="True"
            DragEnter="OnDragEnter"
            DragLeave="OnDragLeave"
            DragOver="OnDragOver"
            Drop="OnDrop">
            <StackPanel
                x:Name="EmptyState"
                AutomationProperties.Name="Drop files here"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon HorizontalAlignment="Center" FontSize="32" Glyph="&#xE8B7;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Text="Drop files here"
                    TextAlignment="Center" />
            </StackPanel>

            <Grid x:Name="BatchSurface" Visibility="Collapsed">
                <ScrollViewer
                    x:Name="BatchScroller"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater
                        x:Name="BatchList"
                        HorizontalCacheLength="0"
                        VerticalCacheLength="0"
                        ElementClearing="OnBatchElementClearing"
                        ElementPrepared="OnBatchElementPrepared"
                        ItemTemplate="{StaticResource BatchTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                x:Name="BatchGridLayout"
                                MinItemWidth="1"
                                MaximumRowsOrColumns="1"
                                MinItemHeight="54"
                                MinColumnSpacing="4"
                                MinRowSpacing="4"
                                ItemsStretch="Fill"
                                ItemsJustification="Start"
                                Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>


            <Border
                x:Name="DragOverlay"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="8"
                Opacity="0.92"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <FontIcon FontSize="28" Foreground="White" Glyph="&#xE8B7;" />
                    <TextBlock Foreground="White" Text="Add to DropCove" />
                </StackPanel>
            </Border>

            <Border
                x:Name="StatusBar"
                VerticalAlignment="Bottom"
                Margin="0,0,0,2"
                Padding="6,4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StatusText"
                        FontSize="10"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Button
                        Grid.Column="1"
                        Width="16"
                        Height="16"
                        MinWidth="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Dismiss status message"
                        Background="Transparent"
                        Click="OnDismissStatusClicked"
                        Content="×"
                        FontSize="11" />
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Actions / Footer -->
        <Grid
            x:Name="BottomActions"
            Grid.Row="2"
            Height="32"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Padding="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Bottom-Left Trash Button -->
            <Button
                x:Name="ClearTemporaryButton"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Style="{StaticResource TitleBarButtonStyle}"
                Width="28"
                Height="28"
                AutomationProperties.Name="Clear Temporary Items"
                Click="OnClearTemporaryClicked"
                ToolTipService.ToolTip="Clear Temporary Items"
                Visibility="Collapsed">
                <FontIcon FontSize="12" Glyph="&#xE74D;" />
            </Button>

        </Grid>
        <Border
            x:Name="ResizeAffordance"
            Grid.RowSpan="3"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="1"
            IsHitTestVisible="False"
            Opacity="0.6"
            Visibility="Collapsed" />
        <Popup
            x:Name="BatchPopup"
            Closed="OnBatchPopupClosed"
            IsLightDismissEnabled="False"
            ShouldConstrainToRootBounds="False">
            <Border
                x:Name="BatchPopupBorder"
                PreviewKeyDown="OnPageKeyDown"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">
                <ScrollViewer
                    x:Name="BatchPopupScroller"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater
                        x:Name="BatchPopupItemList"
                        HorizontalCacheLength="0"
                        VerticalCacheLength="0"
                        ElementClearing="OnPopupItemElementClearing"
                        ElementPrepared="OnPopupItemElementPrepared"
                        ItemTemplate="{StaticResource ShelfItemTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</Page>
