<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DropCove.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DropCove"
    IsTabStop="True"
    KeyDown="OnPageKeyDown"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="CompactBatchTemplate" x:DataType="local:BatchCardViewModel">
            <Border
                Tag="{x:Bind}"
                Margin="0,0,0,4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <Grid
                        MinHeight="52"
                        Padding="4"
                        AutomationProperties.Name="{x:Bind DragBatchAutomationName, Mode=OneWay}"
                        CanDrag="True"
                        ColumnSpacing="6"
                        DragStarting="OnBatchDragStarting"
                        DropCompleted="OnBatchDropCompleted"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Drag all items in batch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="42" Height="42" VerticalAlignment="Center">
                            <Border
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{x:Bind SingleItemVisibility, Mode=OneWay}">
                                <Grid CornerRadius="5">
                                    <FontIcon FontSize="16" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                    <Image Source="{x:Bind PrimaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <Grid Visibility="{x:Bind MultiItemVisibility, Mode=OneWay}">
                                <Border
                                    Margin="5,0,0,5"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid CornerRadius="5">
                                        <FontIcon FontSize="14" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                        <Image Source="{x:Bind TertiaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <Border
                                    Margin="2,2,2,2"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid CornerRadius="5">
                                        <FontIcon FontSize="14" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                        <Image Source="{x:Bind SecondaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <Border
                                    Margin="0,5,5,0"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid CornerRadius="5">
                                        <FontIcon FontSize="14" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                        <Image Source="{x:Bind PrimaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="9"
                                Text="{x:Bind Subtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <ToggleButton
                                Style="{StaticResource TitleBarToggleButtonStyle}"
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="{x:Bind SingleItemPinAutomationName, Mode=OneWay}"
                                Click="OnPinClicked"
                                Tag="{x:Bind}"
                                IsChecked="{x:Bind IsPinned, Mode=OneWay}"
                                ToolTipService.ToolTip="Pin / Unpin"
                                Visibility="{x:Bind SingleItemVisibility, Mode=OneWay}">
                                <FontIcon FontSize="11" Glyph="&#xE718;" />
                            </ToggleButton>
                            <Button
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="{x:Bind ToggleExpandAutomationName, Mode=OneWay}"
                                Click="OnToggleExpandClicked"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Expand/Collapse items"
                                Visibility="{x:Bind MultiItemVisibility, Mode=OneWay}">
                                <FontIcon FontSize="9" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                            </Button>
                            <Button
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="{x:Bind RemoveBatchAutomationName, Mode=OneWay}"
                                Click="OnRemoveBatchClicked"
                                Tag="{x:Bind}"
                                Content="×"
                                FontSize="14"
                                ToolTipService.ToolTip="Remove Batch" />
                        </StackPanel>
                    </Grid>

                    <ItemsRepeater
                        x:Name="CompactItemList"
                        x:Load="{x:Bind IsExpanded, Mode=OneWay}"
                        Margin="4,0,4,4"
                        ElementClearing="OnItemElementClearing"
                        ElementPrepared="OnItemElementPrepared"
                        ItemsSource="{x:Bind Items, Mode=OneWay}"
                        Visibility="{x:Bind ItemsVisibility, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:ShelfItemViewModel">
                                <Border
                                    Margin="0,0,0,4"
                                    Padding="4"
                                    AutomationProperties.Name="{x:Bind DragAutomationName, Mode=OneWay}"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CanDrag="True"
                                    CornerRadius="4"
                                    DragStarting="OnItemDragStarting"
                                    DropCompleted="OnItemDropCompleted"
                                    Tag="{x:Bind}">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="24" Height="24" VerticalAlignment="Center">
                                            <FontIcon IsHitTestVisible="False" FontSize="13" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                            <Image AutomationProperties.Name="{x:Bind VisualAutomationName, Mode=OneWay}" IsHitTestVisible="False" Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                FontSize="9"
                                                Text="{x:Bind DetailsLabel, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton
                                                Style="{StaticResource TitleBarToggleButtonStyle}"
                                                Width="24"
                                                Height="24"
                                                AutomationProperties.Name="{x:Bind PinAutomationName, Mode=OneWay}"
                                                Click="OnPinClicked"
                                                Tag="{x:Bind}"
                                                IsChecked="{x:Bind IsPinned, Mode=OneWay}"
                                                ToolTipService.ToolTip="Pin / Unpin">
                                                <FontIcon FontSize="11" Glyph="&#xE718;" />
                                            </ToggleButton>
                                            <Button
                                                Style="{StaticResource TitleBarButtonStyle}"
                                                Width="24"
                                                Height="24"
                                                AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                                Click="OnRemoveItemClicked"
                                                Tag="{x:Bind}"
                                                Content="×"
                                                FontSize="14"
                                                ToolTipService.ToolTip="Remove Item" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ExpandedBatchTemplate" x:DataType="local:BatchCardViewModel">
            <Border
                Tag="{x:Bind}"
                Margin="0,0,0,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <Grid
                        MinHeight="58"
                        Padding="6"
                        AutomationProperties.Name="{x:Bind DragBatchAutomationName, Mode=OneWay}"
                        CanDrag="True"
                        ColumnSpacing="8"
                        DragStarting="OnBatchDragStarting"
                        DropCompleted="OnBatchDropCompleted"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Drag all available items in batch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="46" Height="46" VerticalAlignment="Center">
                            <Border
                                Margin="5,0,0,5"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{x:Bind MultiItemVisibility, Mode=OneWay}">
                                <Grid CornerRadius="5">
                                    <FontIcon FontSize="15" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                    <Image Source="{x:Bind TertiaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <Border
                                Margin="2,2,2,2"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{x:Bind MultiItemVisibility, Mode=OneWay}">
                                <Grid CornerRadius="5">
                                    <FontIcon FontSize="15" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                    <Image Source="{x:Bind SecondaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <Border
                                Margin="0,0,5,0"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid CornerRadius="5">
                                    <FontIcon FontSize="16" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                    <Image Source="{x:Bind PrimaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="10"
                                Text="{x:Bind Subtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="9"
                                Text="{x:Bind CreatedLabel, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <ToggleButton
                                Style="{StaticResource TitleBarToggleButtonStyle}"
                                Width="26"
                                Height="26"
                                AutomationProperties.Name="{x:Bind SingleItemPinAutomationName, Mode=OneWay}"
                                Click="OnPinClicked"
                                Tag="{x:Bind}"
                                IsChecked="{x:Bind IsPinned, Mode=OneWay}"
                                ToolTipService.ToolTip="Pin / Unpin"
                                Visibility="{x:Bind SingleItemVisibility, Mode=OneWay}">
                                <FontIcon FontSize="11" Glyph="&#xE718;" />
                            </ToggleButton>
                            <Button
                                x:Name="ToggleExpandButton"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="26"
                                Height="26"
                                AutomationProperties.Name="{x:Bind ToggleExpandAutomationName, Mode=OneWay}"
                                Click="OnToggleExpandClicked"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Expand/Collapse items"
                                Visibility="{x:Bind MultiItemVisibility, Mode=OneWay}">
                                <FontIcon FontSize="9" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                            </Button>
                            <Button
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="26"
                                Height="26"
                                AutomationProperties.Name="{x:Bind RemoveBatchAutomationName, Mode=OneWay}"
                                Click="OnRemoveBatchClicked"
                                Tag="{x:Bind}"
                                Content="×"
                                FontSize="14"
                                ToolTipService.ToolTip="Remove Batch" />
                        </StackPanel>
                    </Grid>

                    <ItemsRepeater
                        x:Name="ExpandedItemList"
                        x:Load="{x:Bind IsExpanded, Mode=OneWay}"
                        Margin="6,0,6,6"
                        ElementClearing="OnItemElementClearing"
                        ElementPrepared="OnItemElementPrepared"
                        ItemsSource="{x:Bind Items, Mode=OneWay}"
                        Visibility="{x:Bind ItemsVisibility, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:ShelfItemViewModel">
                                <Border
                                    Padding="6"
                                    AutomationProperties.Name="{x:Bind DragAutomationName, Mode=OneWay}"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CanDrag="True"
                                    CornerRadius="4"
                                    DragStarting="OnItemDragStarting"
                                    DropCompleted="OnItemDropCompleted"
                                    Tag="{x:Bind}">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                                            <FontIcon IsHitTestVisible="False" FontSize="14" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                            <Image
                                                AutomationProperties.Name="{x:Bind VisualAutomationName, Mode=OneWay}"
                                                IsHitTestVisible="False"
                                                Source="{x:Bind Icon, Mode=OneWay}"
                                                Stretch="UniformToFill" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Margin="2,0,0,0">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                FontSize="9"
                                                Text="{x:Bind Path, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                FontSize="9"
                                                Text="{x:Bind DetailsLabel, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton
                                                Style="{StaticResource TitleBarToggleButtonStyle}"
                                                Width="28"
                                                Height="28"
                                                AutomationProperties.Name="{x:Bind PinAutomationName, Mode=OneWay}"
                                                Click="OnPinClicked"
                                                Tag="{x:Bind}"
                                                IsChecked="{x:Bind IsPinned, Mode=OneWay}"
                                                ToolTipService.ToolTip="Pin / Unpin">
                                                <FontIcon FontSize="12" Glyph="&#xE718;" />
                                            </ToggleButton>
                                            <Button
                                                Style="{StaticResource TitleBarButtonStyle}"
                                                Width="28"
                                                Height="28"
                                                AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                                Click="OnRemoveItemClicked"
                                                Tag="{x:Bind}"
                                                Content="×"
                                                FontSize="16"
                                                ToolTipService.ToolTip="Remove Item" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="DragRegion"
                Grid.Column="0"
                Background="Transparent"
                PointerPressed="OnDragRegionPointerPressed" />

            <Button
                x:Name="SettingsButton"
                Grid.Column="1"
                Style="{StaticResource TitleBarButtonStyle}"
                Width="32"
                Height="32"
                AutomationProperties.Name="Settings"
                Click="OnSettingsClicked"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="12" Glyph="&#xE713;" />
            </Button>

            <Button
                x:Name="CloseButton"
                Grid.Column="2"
                Style="{StaticResource TitleBarButtonStyle}"
                Width="36"
                Height="32"
                AutomationProperties.Name="Hide DropCove"
                Click="OnCloseClicked"
                ToolTipService.ToolTip="Hide DropCove">
                <FontIcon FontSize="11" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <Grid
            AutomationProperties.Name="Drop Shelf content and drop target"
            x:Name="ContentSurface"
            Grid.Row="1"
            Padding="8"
            AllowDrop="True"
            DragEnter="OnDragEnter"
            DragLeave="OnDragLeave"
            DragOver="OnDragOver"
            Drop="OnDrop">
            <StackPanel
                x:Name="EmptyState"
                AutomationProperties.Name="Drop files here"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon HorizontalAlignment="Center" FontSize="32" Glyph="&#xE8B7;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Text="Drop files here"
                    TextAlignment="Center" />
            </StackPanel>

            <Grid x:Name="CompactSurface" Visibility="Collapsed">
                <ScrollViewer
                    x:Name="CompactBatchScroller"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater
                        x:Name="CompactBatchList"
                        ElementClearing="OnBatchElementClearing"
                        ElementPrepared="OnBatchElementPrepared"
                        ItemTemplate="{StaticResource CompactBatchTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ExpandedSurface" Visibility="Collapsed">
                <ScrollViewer
                    x:Name="ExpandedBatchScroller"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater
                        x:Name="ExpandedBatchList"
                        ElementClearing="OnBatchElementClearing"
                        ElementPrepared="OnBatchElementPrepared"
                        ItemTemplate="{StaticResource ExpandedBatchTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>

            <Border
                x:Name="DragOverlay"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="8"
                Opacity="0.92"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <FontIcon FontSize="28" Foreground="White" Glyph="&#xE8B7;" />
                    <TextBlock Foreground="White" Text="Add to DropCove" />
                </StackPanel>
            </Border>

            <Border
                x:Name="StatusBar"
                VerticalAlignment="Bottom"
                Margin="0,0,0,2"
                Padding="6,4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StatusText"
                        FontSize="10"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Button
                        Grid.Column="1"
                        Width="16"
                        Height="16"
                        MinWidth="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Dismiss status message"
                        Background="Transparent"
                        Click="OnDismissStatusClicked"
                        Content="×"
                        FontSize="11" />
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Actions / Footer -->
        <Grid
            x:Name="BottomActions"
            Grid.Row="2"
            Height="32"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Padding="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Bottom-Left Trash Button -->
            <Button
                x:Name="ClearTemporaryButton"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Style="{StaticResource TitleBarButtonStyle}"
                Width="28"
                Height="28"
                AutomationProperties.Name="Clear Temporary Items"
                Click="OnClearTemporaryClicked"
                ToolTipService.ToolTip="Clear Temporary Items"
                Visibility="Collapsed">
                <FontIcon FontSize="12" Glyph="&#xE74D;" />
            </Button>

            <!-- Bottom-Right Expand / Compact Button -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <Button
                    x:Name="ExpandModeButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Height="28"
                    Padding="6,0"
                    AutomationProperties.Name="Open Expanded management view"
                    Click="OnExpandedModeClicked"
                    ToolTipService.ToolTip="Expand DropCove">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="11" Glyph="&#xE740;" />
                        <TextBlock FontSize="10" Text="Expand" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="CompactModeButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Height="28"
                    Padding="6,0"
                    AutomationProperties.Name="Return to Compact view"
                    Click="OnCompactModeClicked"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Compact DropCove">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="11" Glyph="&#xE73F;" />
                        <TextBlock FontSize="10" Text="Compact" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
