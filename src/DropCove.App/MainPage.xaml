<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DropCove.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon HorizontalAlignment="Center" FontSize="40" Glyph="&#xE8A5;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="Drop Shelf" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="A temporary drag-and-drop space for Windows." />
        </StackPanel>
    </Grid>
</Page>
