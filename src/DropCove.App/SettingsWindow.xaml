<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DropCove.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DropCove Settings">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Edge Rail" />
            <ComboBox
                x:Name="RailEdgeComboBox"
                AutomationProperties.Name="Docking edge"
                Header="Docking edge"
                DisplayMemberPath="Name" />
            <ComboBox
                x:Name="RailMonitorComboBox"
                AutomationProperties.Name="Target monitor"
                Header="Target monitor"
                DisplayMemberPath="Label" />
            <ToggleSwitch
                x:Name="ShowRailOverFullscreenToggle"
                AutomationProperties.Name="Show Edge Rail over fullscreen applications"
                Header="Show over fullscreen applications"
                OnContent="On"
                OffContent="Off" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Shake-to-open" />
            <ToggleSwitch
                x:Name="ShakeEnabledToggle"
                AutomationProperties.Name="Enable shake gesture"
                Header="Enable shake gesture"
                OnContent="On"
                OffContent="Off" />
            <ComboBox
                x:Name="ShakeSensitivityComboBox"
                AutomationProperties.Name="Shake sensitivity"
                Header="Shake sensitivity"
                DisplayMemberPath="Name" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Global hotkey" />
            <StackPanel x:Name="HotKeyEditor" Spacing="6">
                <Button
                    x:Name="HotKeyRecorder"
                    AutomationProperties.AutomationId="GlobalHotkeyRecorder"
                    AutomationProperties.Name="Global hotkey"
                    AutomationProperties.HelpText="Click or press Enter or Space to record a shortcut."
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OnHotKeyRecorderClicked"
                    PreviewKeyDown="OnHotKeyPreviewKeyDown"
                    PreviewKeyUp="OnHotKeyPreviewKeyUp"
                    GotFocus="OnHotKeyGotFocus"
                    LostFocus="OnHotKeyLostFocus">
                    <TextBlock x:Name="HotKeyValueText" TextWrapping="Wrap" />
                </Button>
                <TextBlock
                    x:Name="HotKeyStatusText"
                    AutomationProperties.LiveSetting="Polite"
                    Text="Click or press Enter or Space to record a shortcut."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ToggleSwitch
                x:Name="StartWithWindowsToggle"
                AutomationProperties.Name="Start DropCove with Windows"
                Header="Start with Windows"
                OnContent="On"
                OffContent="Off" />

            <InfoBar
                x:Name="ErrorInfoBar"
                AutomationProperties.Name="Settings validation message"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Click="OnCancelClicked" Content="Cancel" />
                <Button x:Name="SaveButton" AutomationProperties.AutomationId="SaveSettings" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClicked" Content="Save" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
