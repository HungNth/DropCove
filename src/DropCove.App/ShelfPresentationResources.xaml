<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="DropCove.ShelfPresentationResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DropCove">
        <DataTemplate x:Key="BulkPinIconTemplate" x:DataType="local:BatchCardViewModel">
            <Grid Width="14" Height="14">
                <FontIcon FontSize="11" Glyph="&#xE718;" />
                <Border
                    Width="8"
                    Height="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    CornerRadius="1"
                    Visibility="{x:Bind MixedPinVisibility, Mode=OneWay}">
                    <Rectangle Width="6" Height="2" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>
            <DataTemplate x:Key="ShelfBatchPreviewTemplate" x:DataType="local:BatchCardViewModel">
                        <Grid Width="42" Height="42" VerticalAlignment="Center">
                            <Border
                                x:Name="SingleIconBorder"
                                x:Load="{x:Bind IsSingleItem, Mode=OneWay}"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid CornerRadius="5">
                                    <FontIcon FontSize="16" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                    <Image Source="{x:Bind PrimaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <Grid x:Name="MultiIconGrid" x:Load="{x:Bind IsMultiItem, Mode=OneWay}">
                                <Border
                                    Margin="5,0,0,5"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid CornerRadius="5">
                                        <FontIcon FontSize="14" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                        <Image Source="{x:Bind TertiaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <Border
                                    Margin="2,2,2,2"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid CornerRadius="5">
                                        <FontIcon FontSize="14" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                        <Image Source="{x:Bind SecondaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <Border
                                    Margin="0,5,5,0"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid CornerRadius="5">
                                        <FontIcon FontSize="14" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                                        <Image Source="{x:Bind PrimaryIcon, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
            </DataTemplate>
    <DataTemplate x:Key="ShelfItemVisualTemplate" x:DataType="local:ShelfItemViewModel">
                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                        <FontIcon IsHitTestVisible="False" FontSize="13" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" />
                        <Image AutomationProperties.Name="{x:Bind VisualAutomationName, Mode=OneWay}" IsHitTestVisible="False" Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
    </DataTemplate>
</ResourceDictionary>
